# Copy this file to ".env" and put your real key in it.
#
#     cp .env.example .env
#
# .env is listed in .gitignore, so your key never reaches a repository.
# The example file is what gets committed, so a new teammate can see
# which variables they need without ever seeing a secret.

GROQ_API_KEY=gsk_put_your_real_key_here
